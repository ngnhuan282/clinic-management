{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
   "DefaultConnection": "Server=localhost;Database=ClinicManagementDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  },
  
  "Jwt": {
    "Key": "your-secret-key-min-32-characters",
